// Zellij config, set up to behave like tmux/.tmux.conf.
// This is the windows-native zellij (zellij.exe running wsl.exe), so it isn't
// a stow package: ansible/setup.yml sets the windows user's ZELLIJ_CONFIG_FILE
// to this file's \\wsl.localhost path. Every option zellij has, with
// comments, is printed by `zellij setup --dump-config`.

// tmux-style keys: Ctrl a is the prefix and everything else waits for it.
// clear-defaults drops zellij's Ctrl p/t/n/s/o/h/g/q mode keys, which clash
// with nvim.
keybinds clear-defaults=true {
    normal {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
        // vim-tmux-navigator can't work here: zellij runs on windows and can't
        // see that nvim is running inside wsl.exe. Alt hjkl moves between
        // panes instead, so Ctrl hjkl stays with nvim.
        bind "Alt h" "Alt Left" { MoveFocusOrTab "Left"; }
        bind "Alt l" "Alt Right" { MoveFocusOrTab "Right"; }
        bind "Alt j" "Alt Down" { MoveFocus "Down"; }
        bind "Alt k" "Alt Up" { MoveFocus "Up"; }
        bind "Alt n" { NewPane; }
        bind "Alt f" { ToggleFloatingPanes; }
        bind "Alt =" "Alt +" { Resize "Increase"; }
        bind "Alt -" { Resize "Decrease"; }
        bind "Alt i" { MoveTab "Left"; }
        bind "Alt o" { MoveTab "Right"; }
        bind "Alt [" { PreviousSwapLayout; }
        bind "Alt ]" { NextSwapLayout; }
    }
    // the prefix table
    tmux {
        // send-prefix: Ctrl a twice passes Ctrl a through
        bind "Ctrl a" { Write 1; SwitchToMode "Normal"; }
        // new panes already start in the current pane's directory
        bind "\"" { NewPane "Down"; SwitchToMode "Normal"; }
        bind "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "h" "Left" { MoveFocus "Left"; SwitchToMode "Normal"; }
        bind "j" "Down" { MoveFocus "Down"; SwitchToMode "Normal"; }
        bind "k" "Up" { MoveFocus "Up"; SwitchToMode "Normal"; }
        bind "l" "Right" { MoveFocus "Right"; SwitchToMode "Normal"; }
        // resize stays in this mode so the key can be held down, like tmux's
        // bind -r. zellij has no repeat timeout: Esc or Enter leaves.
        bind "Ctrl h" { Resize "Increase Left"; }
        bind "Ctrl j" { Resize "Increase Down"; }
        bind "Ctrl k" { Resize "Increase Up"; }
        bind "Ctrl l" { Resize "Increase Right"; }
        bind "c" { NewTab; SwitchToMode "Normal"; }
        bind "n" { GoToNextTab; SwitchToMode "Normal"; }
        bind "p" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }
        bind "$" { SwitchToMode "RenameSession"; SessionNameInput 0; }
        bind "&" { CloseTab; SwitchToMode "Normal"; }
        bind "x" { CloseFocus; SwitchToMode "Normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }
        bind "o" { FocusNextPane; SwitchToMode "Normal"; }
        bind ";" { FocusLastPane; SwitchToMode "Normal"; }
        bind "Space" { NextSwapLayout; SwitchToMode "Normal"; }
        // copy-mode
        bind "[" { SwitchToMode "Scroll"; }
        bind "d" { Detach; }
        bind "s" "w" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal"
        }
        // toggle mouse, like prefix m
        bind "m" { ToggleMouseMode; SwitchToMode "Normal"; }
        // closest thing to prefix a (monitor-activity)
        bind "a" { WatchPane; SwitchToMode "Normal"; }
    }
    // vi-style copy-mode. Selecting is done with the mouse (copy_on_select).
    scroll {
        bind "q" "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "d" "Ctrl d" { HalfPageScrollDown; }
        bind "u" "Ctrl u" { HalfPageScrollUp; }
        bind "g" { ScrollToTop; }
        bind "G" { ScrollToBottom; }
        bind "[" { ScrollToPreviousPrompt; }
        bind "]" { ScrollToNextPrompt; }
        bind "/" "?" { SwitchToMode "EnterSearch"; SearchInput 0; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
    }
    search {
        bind "q" "Ctrl c" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "d" "Ctrl d" { HalfPageScrollDown; }
        bind "u" "Ctrl u" { HalfPageScrollUp; }
        bind "n" { Search "down"; }
        bind "N" "p" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }
    entersearch {
        bind "Ctrl c" "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }
    renametab {
        bind "Enter" "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
    }
    renamepane {
        bind "Enter" "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
    }
    renamesession {
        bind "Enter" "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameSession; SwitchToMode "Normal"; }
    }
    // the rename and enter-search modes have their own Enter and Esc above
    shared_except "normal" "renametab" "renamepane" "renamesession" "entersearch" {
        bind "Enter" "Esc" { SwitchToMode "Normal"; }
    }
}

// Plugin aliases - changing these requires a restart
plugins {
    about location="zellij:about"
    compact-bar location="zellij:bars" {
        role "compact-bar"
    }
    configuration location="zellij:configuration"
    context-menu location="zellij:context-menu"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    prompt location="zellij:prompt"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:bars" {
        role "status-bar"
    }
    strider location="zellij:strider"
    tab-bar location="zellij:bars" {
        role "tab-bar"
    }
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

load_plugins {
    zellij:bars {
        role "link"
    }
}

web_client {
    font "monospace"
}

theme "catppuccin-macchiato"
default_shell "wsl.exe"

// one bar of tabs, like the tmux status line
default_layout "compact"
// tmux draws plain borders between panes, not a frame around each one
pane_frames false
mouse_mode true
// tmux-sensible's history-limit
scroll_buffer_size 50000

// tmux-resurrect and tmux-continuum: sessions are saved and can be brought
// back with `zellij attach <name>` or the session manager (prefix s)
session_serialization true
serialize_pane_viewport true

terminal {
    font "Cascadia Code"
    font_size 13
    cursor_style "block"
    cursor_blink false
    startup_mode "maximized"
    opacity 0.5
    blur true
    padding 8
}
