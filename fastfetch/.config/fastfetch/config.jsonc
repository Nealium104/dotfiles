// boxed layout from fastfetch's examples/25 preset, narrowed from 112 columns
// to 55: the small logo sits on top instead of beside the box, the value area
// is 36 columns instead of 46, and there is no desktop section.
// colors are catppuccin macchiato, to match wezterm, starship and btop.
//
// the constants draw the right-hand borders: {$1} and {$5} are the horizontal
// lines, {$2} to {$4} move the cursor (left 37, right 37, right 36) so a
// border can be printed past the value and the cursor brought back. a value
// longer than 35 characters runs over the border
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "ubuntu_small",
    "position": "top",
    "color": {
      "1": "#f5a97f"
    },
    "padding": {
      "top": 1,
      "left": 16
    }
  },
  "display": {
    "separator": "",
    "color": {
      "keys": "#8aadf4",
      "output": "#cad3f5"
    },
    "constants": [
      "────────────────────────────────────",
      "\u001b[37D",
      "\u001b[37C",
      "\u001b[36C",
      "════════════════════════════════════"
    ],
    "brightColor": false
  },
  "modules": [
    {
      "type": "title",
      "key": "╔═══════════════╦═{$5}╗\u001b[31D",
      "format": "\u001b[1m{#keys} {user-name}@{host-name} "
    },
    {
      "type": "os",
      "key": "║  {icon}  OS        ║{$3}║{$2}",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "║  {icon}  Kernel    ║{$3}║{$2}",
      "format": "{release}"
    },
    {
      "type": "uptime",
      "key": "║  {icon}  Uptime    ║{$3}║{$2}"
    },
    {
      "type": "disk",
      "keyIcon": "",
      "key": "║  {icon}  OS Age    ║{$3}║{$2}",
      "folders": "/",
      "format": "{create-time:10} [{days} days]"
    },
    {
      "type": "custom",
      "key": "║{#38;2;139;213;202}┌──────────────┬{$1}┐{#keys}║\u001b[27D",
      "format": "{#38;2;139;213;202} Hardware "
    },
    {
      "type": "cpu",
      "key": "║{#38;2;139;213;202}│ {icon}  CPU       │{$4}│{#keys}║{$2}",
      "format": "{name} ({cores-logical})"
    },
    {
      "type": "gpu",
      "key": "║{#38;2;139;213;202}│ {icon}  GPU       │{$4}│{#keys}║{$2}",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "║{#38;2;139;213;202}│ {icon}  RAM       │{$4}│{#keys}║{$2}"
    },
    {
      "type": "disk",
      "key": "║{#38;2;139;213;202}│ {icon}  Disk      │{$4}│{#keys}║{$2}",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "custom",
      "key": "║{#38;2;139;213;202}└──────────────┴{$1}┘{#keys}║",
      "format": ""
    },
    {
      "type": "custom",
      "key": "║{#38;2;238;212;159}┌──────────────┬{$1}┐{#keys}║\u001b[27D",
      "format": "{#38;2;238;212;159} Terminal "
    },
    {
      "type": "shell",
      "key": "║{#38;2;238;212;159}│ {icon}  Shell     │{$4}│{#keys}║{$2}"
    },
    {
      "type": "terminal",
      "key": "║{#38;2;238;212;159}│ {icon}  Terminal  │{$4}│{#keys}║{$2}"
    },
    {
      "type": "packages",
      "key": "║{#38;2;238;212;159}│ {icon}  Packages  │{$4}│{#keys}║{$2}"
    },
    {
      "type": "custom",
      "key": "║{#38;2;238;212;159}└──────────────┴{$1}┘{#keys}║",
      "format": ""
    },
    {
      "type": "custom",
      "key": "║{#38;2;237;135;150}┌──────────────┬{$1}┐{#keys}║\u001b[27D",
      "format": "{#38;2;237;135;150} Development "
    },
    {
      "type": "command",
      "keyIcon": "",
      "key": "║{#38;2;237;135;150}│ {icon}  Rust      │{$4}│{#keys}║{$2}",
      "text": "rustc --version | cut -d' ' -f2",
      "format": "rustc {}"
    },
    {
      "type": "command",
      "keyIcon": "",
      "key": "║{#38;2;237;135;150}│ {icon}  NodeJS    │{$4}│{#keys}║{$2}",
      "text": "node --version",
      "format": "node {~1}"
    },
    {
      "type": "command",
      "keyIcon": "",
      "key": "║{#38;2;237;135;150}│ {icon}  Go        │{$4}│{#keys}║{$2}",
      "text": "go version | cut -d' ' -f3",
      "format": "go {~2}"
    },
    {
      "type": "command",
      "keyIcon": "",
      "key": "║{#38;2;237;135;150}│ {icon}  PHP       │{$4}│{#keys}║{$2}",
      "text": "php -r 'echo PHP_VERSION;'",
      "format": "php {}"
    },
    {
      "type": "command",
      "keyIcon": "",
      "key": "║{#38;2;237;135;150}│ {icon}  Python    │{$4}│{#keys}║{$2}",
      "text": "python3 --version",
      "format": "python {~7}"
    },
    {
      "type": "command",
      "keyIcon": "",
      "key": "║{#38;2;237;135;150}│ {icon}  Docker    │{$4}│{#keys}║{$2}",
      "text": "docker --version | cut -d' ' -f3 | tr -d ,",
      "format": "docker {}"
    },
    {
      "type": "editor",
      "key": "║{#38;2;237;135;150}│ {icon}  Editor    │{$4}│{#keys}║{$2}"
    },
    {
      "type": "command",
      "keyIcon": "󰊢",
      "key": "║{#38;2;237;135;150}│ {icon}  Git       │{$4}│{#keys}║{$2}",
      "text": "git version",
      "format": "git {~12}"
    },
    {
      "type": "custom",
      "key": "║{#38;2;237;135;150}└──────────────┴{$1}┘{#keys}║",
      "format": ""
    },
    {
      "type": "custom",
      "key": "╚═════════════════{$5}╝",
      "format": ""
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
