# generated by dotfiles/ansible/setup.yml
# template at ansible/templates/wsl.conf.j2; edit there
# applies to every WSL distro; takes effect after `wsl --shutdown`

[boot]
# for docker's service and the binfmt.d registration
systemd=true

[user]
default={{ ansible_facts.user_id }}

[interop]
# setup.yml runs powershell and choco
enabled=true
appendWindowsPath=true

[automount]
enabled=true
# metadata lets chmod and ownership stick on /mnt/c
options="metadata,uid={{ ansible_facts.user_uid }},gid={{ ansible_facts.user_gid }},umask=022,fmask=0022"
