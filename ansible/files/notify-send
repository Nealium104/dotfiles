#!/usr/bin/env bash

# notify-send for WSL, where there is no Linux notification service: shows a
# Windows toast instead. Called like the real one (notify-send [options] title
# [body]); options are accepted and ignored.

args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -t | -u | -i | -a | -c | -h)
      shift
      [ $# -gt 0 ] && shift
      ;;
    -*) shift ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done

# passed through the environment so nothing in the text has to be quoted for
# powershell. WSLENV names the variables WSL copies across to windows
export NOTIFY_TITLE="${args[0]:-Notification}" NOTIFY_BODY="${args[1]:-}"
export WSLENV="NOTIFY_TITLE:NOTIFY_BODY${WSLENV:+:$WSLENV}"

# the long id is powershell's own; windows drops toasts from unregistered apps
# shellcheck disable=SC2016 # powershell's variables, not bash's
script='
[Windows.UI.Notifications.ToastNotificationManager, Windows.UI.Notifications, ContentType = WindowsRuntime] | Out-Null
$xml = [Windows.UI.Notifications.ToastNotificationManager]::GetTemplateContent([Windows.UI.Notifications.ToastTemplateType]::ToastText02)
$text = $xml.GetElementsByTagName("text")
$text.Item(0).AppendChild($xml.CreateTextNode($env:NOTIFY_TITLE)) | Out-Null
$text.Item(1).AppendChild($xml.CreateTextNode($env:NOTIFY_BODY)) | Out-Null
$app = "{1AC14E77-02E7-4E5D-B744-2EB1AE5198B7}\WindowsPowerShell\v1.0\powershell.exe"
[Windows.UI.Notifications.ToastNotificationManager]::CreateToastNotifier($app).Show([Windows.UI.Notifications.ToastNotification]::new($xml))
'

# in the background: powershell takes about a second to start, and the caller
# may be drawing a status line
(cd /mnt/c && powershell.exe -NoProfile -NonInteractive -Command "$script") > /dev/null 2>&1 &
