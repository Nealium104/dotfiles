[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential
[user]
	email = neal.powers@outlook.com
	name = Neal Powers
[init]
	defaultBranch = main
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	syntax-theme = Catppuccin Macchiato
[alias]
	st = status -sb
	lg = log --oneline --graph --decorate
	amend = commit --amend --no-edit
[diff]
	tool = difftastic
	algorithm = histogram
	# moved lines show as moved, not as a delete and an add
	colorMoved = default
[difftool]
	prompt = false
[difftool "difftastic"]
	cmd = difft "$LOCAL" "$REMOTE"
[pager]
	difftool = true
[rebase]
	autoStash = true
	# fixup!/squash! commits move into place in `rebase -i`
	autoSquash = true
	# branches stacked on the one being rebased move with it
	updateRefs = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[merge]
	conflictStyle = zdiff3
[rerere]
	enabled = true
[branch]
	sort = -committerdate
[commit]
	verbose = true
[tag]
	# v1.10 after v1.9, not after v1.1
	sort = version:refname
[help]
	# Mistyped commands (git stuats) ask "Run 'status' instead?" rather than failing
	autocorrect = prompt
[includeIf "hasconfig:remote.*.url:https://github.com/Nealium104/**"]
	path = ~/.gitconfig-personal
[includeIf "hasconfig:remote.*.url:git@github.com:Nealium104/**"]
	path = ~/.gitconfig-personal
